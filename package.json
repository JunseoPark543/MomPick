{
  "name": "mompick-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @mompick/mobile",
    "seed": "node scripts/seed.mjs",
    "db:types": "supabase gen types --remote --schema public > packages/shared/src/database.types.ts",
    "db:push": "supabase db push --remote",
    "db:status": "supabase migration list --remote",
    "admin": "npm run dev --workspace @mompick/admin"
  },
  "devDependencies": {
    "supabase": "^3.1.0"
  }
}
